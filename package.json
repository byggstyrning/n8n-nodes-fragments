{
  "name": "n8n-nodes-fragments",
  "version": "0.1.1",
  "description": "n8n node that converts IFC files to That Open Fragments (.frag) inside the n8n instance, in an isolated child process",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ifc",
    "bim",
    "fragments",
    "thatopen",
    "web-ifc",
    "openbim"
  ],
  "license": "MIT",
  "homepage": "https://github.com/byggstyrning/n8n-nodes-fragments#readme",
  "bugs": {
    "url": "https://github.com/byggstyrning/n8n-nodes-fragments/issues"
  },
  "author": {
    "name": "Byggstyrning",
    "email": "jonatan.jacobsson@byggstyrning.se"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byggstyrning/n8n-nodes-fragments.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.0",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint nodes package.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "compare": "node scripts/compare-with-importer.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/Fragments/Fragments.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.36.0",
    "@thatopen/fragments": "3.4.3",
    "@types/node": "22.20.5",
    "@typescript-eslint/parser": "8.70.0",
    "earcut": "3.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "1.16.7",
    "flatbuffers": "25.2.10",
    "n8n-workflow": "2.36.4",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "web-ifc": "0.0.77"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "pnpm": {
    "overrides": {
      "earcut": "3.2.3",
      "flatbuffers": "25.2.10",
      "pako": "2.1.0",
      "lru-cache": "11.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
